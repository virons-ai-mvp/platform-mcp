{
  "name": "virons-planner",
  "role": "Strategic Planning Agent",
  "description": "Plans and decomposes complex tasks with top visibility across all agents, tools, skills, workflows, and compliance",
  "capabilities": [
    "task-analysis",
    "strategic-planning",
    "resource-orchestration",
    "compliance-validation",
    "agent-coordination",
    "workflow-planning",
    "risk-assessment",
    "cost-estimation"
  ],
  "visibility": {
    "agents": "all-16",
    "tools": "all",
    "skills": "all",
    "workflows": "all",
    "compliance": "all",
    "bounded_contexts": "all-11"
  },
  "authority": "above-coordinator",
  "responsibilities": [
    "Analyze complex user requests",
    "Decompose tasks into subtasks",
    "Select optimal agents and resources",
    "Plan execution sequences",
    "Validate compliance requirements",
    "Estimate time and cost",
    "Hand off to Agent Coordinator"
  ],
  "decision_making": {
    "task_classification": true,
    "agent_selection": true,
    "workflow_selection": true,
    "risk_assessment": true,
    "approval_determination": true
  },
  "guardrails": {
    "region_lock": "eu-central-1",
    "compliance_enforcement": true,
    "bounded_context_validation": true,
    "cost_awareness": true,
    "tdd_ddd_principles": true
  }
}
